---
import { siteConfig } from "@/config/site";

const social = [
  { href: siteConfig.social.instagram, label: "Instagram" },
  { href: siteConfig.social.twitter, label: "Twitter" },
  { href: siteConfig.social.linkedin, label: "LinkedIn" },
  { href: siteConfig.social.github, label: "GitHub" }
];
---

<footer class="border-t border-line">
  <div class="mx-auto grid w-full max-w-[1600px] gap-12 px-5 py-14 md:grid-cols-[1fr_auto] md:items-end md:px-8 md:py-20 lg:px-12">
    <div>
      <p class="max-w-2xl font-display text-3xl leading-[1.05] text-text md:text-5xl">
        Photographs by {siteConfig.author}.
      </p>
      <p class="mt-4 max-w-lg text-sm leading-6 text-muted">
        Landscapes, cities, forests, and mountain weather.
      </p>
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-3 md:justify-end">
      {social.map((item) => (
        <a
          class="border-b border-lineStrong pb-1 text-sm text-muted transition-colors duration-medium hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          href={item.href}
          target="_blank"
          rel="noreferrer"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</footer>
