<dialog
  id="photo-lightbox"
  class="m-0 h-[100dvh] max-h-none w-full max-w-none overflow-y-auto bg-[#080a09]/98 p-0 text-[#edf2f0] backdrop:bg-[#080a09]/96"
  aria-label="Photograph viewer"
>
  <div class="mx-auto flex min-h-full w-full max-w-[1800px] flex-col px-4 py-4 sm:px-6 md:h-full md:px-8 md:py-6">
    <div class="mb-4 flex items-center justify-between gap-3 border-b border-white/15 pb-4">
      <p id="lightbox-position" class="text-xs tabular-nums text-white/60"></p>
      <button
        type="button"
        id="lightbox-close"
        class="border-b border-white/45 pb-1 text-sm text-white transition-colors duration-medium hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent active:translate-y-px"
      >
        Close
      </button>
    </div>

    <div class="grid min-h-0 flex-1 gap-6 md:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10">
      <div class="min-w-0">
        <div
          id="lightbox-media-container"
          class="relative flex min-h-[55dvh] items-center justify-center overflow-hidden md:min-h-0"
        >
          <p id="lightbox-status" class="px-6 text-center text-sm text-white/70" role="status">Loading photograph</p>
          <img
            id="lightbox-image"
            alt=""
            class="hidden max-h-[68dvh] w-auto max-w-full object-contain"
          />
        </div>

        <div class="mt-4 grid grid-cols-2 border-y border-white/15">
          <button
            type="button"
            id="lightbox-prev"
            class="min-h-11 border-r border-white/15 px-4 py-3 text-left text-sm font-medium text-white transition-colors duration-medium hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent active:translate-y-px"
            aria-label="Previous photograph"
          >
            Previous
          </button>
          <button
            type="button"
            id="lightbox-next"
            class="min-h-11 px-4 py-3 text-right text-sm font-medium text-white transition-colors duration-medium hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent active:translate-y-px"
            aria-label="Next photograph"
          >
            Next
          </button>
        </div>
      </div>

      <aside class="self-start border-t border-white/15 pt-5 md:border-l md:border-t-0 md:pl-6 md:pt-0">
        <p id="lightbox-title" class="font-display text-2xl leading-tight text-white"></p>
        <p id="lightbox-description" class="mt-3 text-sm leading-6 text-white/62"></p>
        <dl class="mt-8 grid grid-cols-2 gap-x-5 gap-y-5 text-xs md:grid-cols-1 lg:grid-cols-2">
          <div data-lightbox-meta>
            <dt class="text-white/55">Date</dt>
            <dd id="lightbox-date" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Location</dt>
            <dd id="lightbox-location" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Camera</dt>
            <dd id="lightbox-camera" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Lens</dt>
            <dd id="lightbox-lens" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Aperture</dt>
            <dd id="lightbox-aperture" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Shutter</dt>
            <dd id="lightbox-shutter" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">ISO</dt>
            <dd id="lightbox-iso" class="mt-1 text-white/85"></dd>
          </div>
          <div data-lightbox-meta>
            <dt class="text-white/55">Focal length</dt>
            <dd id="lightbox-focal-length" class="mt-1 text-white/85"></dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</dialog>
