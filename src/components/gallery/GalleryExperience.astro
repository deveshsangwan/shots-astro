---
import { Image } from "astro:assets";
import PhotoLightbox from "@/components/lightbox/PhotoLightbox.astro";
import type { PhotoViewModel } from "@/types/photo";
import { withBase } from "@/utils/withBase";

interface Props {
  photos: PhotoViewModel[];
  tags: string[];
  selectedPhotoIds?: string[];
}

const {
  photos: allPhotos,
  tags,
  selectedPhotoIds = []
} = Astro.props;

const photosById = new Map(allPhotos.map((photo) => [photo.id, photo]));
const selectedPhotos = selectedPhotoIds
  .map((id) => photosById.get(id))
  .filter((photo): photo is PhotoViewModel => Boolean(photo));
const selectedSet = new Set(selectedPhotos.map((photo) => photo.id));
const photos = [
  ...selectedPhotos,
  ...allPhotos.filter((photo) => !selectedSet.has(photo.id))
];
const initialVisibleCount = selectedPhotos.length || Math.min(photos.length, 12);
---

<section class="mx-auto w-full max-w-7xl px-5 py-10 md:px-8 md:py-14" aria-labelledby="gallery-heading">
  <div class="max-w-2xl">
    <h2 id="gallery-heading" class="font-display text-3xl text-text md:text-4xl">Selected photographs</h2>
    <p class="mt-3 max-w-xl text-sm leading-7 text-muted md:text-base">
      A focused edit from landscapes, city streets, and the quieter frames in between.
    </p>

    {photos.length > initialVisibleCount && (
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          id="archive-toggle"
          type="button"
          class="rounded-full border border-lineStrong px-5 py-2.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98]"
          aria-expanded="false"
          data-collapsed-label="View full archive"
          data-expanded-label="Show selected photographs"
        >
          View full archive
        </button>
        <p id="gallery-count" class="text-sm text-muted" aria-live="polite">
          Showing {initialVisibleCount} of {photos.length}
        </p>
      </div>
    )}
  </div>

  {tags.length > 0 && (
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter photographs by theme">
      <button
        type="button"
        class="tag-pill rounded-full border border-accent bg-accent/10 px-4 py-1.5 text-sm text-accent transition-colors"
        data-tag=""
        aria-pressed="true"
      >
        All
      </button>
      {tags.map((tag) => (
        <button
          type="button"
          class="tag-pill rounded-full border border-lineStrong px-4 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          data-tag={tag}
          aria-pressed="false"
        >
          {tag}
        </button>
      ))}
    </nav>
  )}

  {
    photos.length > 0 ? (
      <div id="photo-grid" class="masonry-grid mt-9">
        {photos.map((photo, index) => (
          <article
            class:list={["group min-w-0", index >= initialVisibleCount && "hidden"]}
            data-photo-card
            data-animate
            data-photo-id={photo.id}
            data-tags={photo.tags.join("|")}
            data-photo-aspect={photo.thumbnail.width / photo.thumbnail.height}
          >
            <button
              class="block w-full cursor-zoom-in overflow-hidden rounded-xl border border-line bg-surface text-left leading-none transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg"
              type="button"
              data-open-lightbox={photo.id}
              aria-label={`Open ${photo.title} in the image viewer`}
            >
              <Image
                src={photo.thumbnailAsset}
                alt={photo.title}
                widths={[320, 480, 640, 800]}
                sizes="(min-width: 1280px) 23vw, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw"
                format="webp"
                quality={index === 0 ? 72 : 68}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
                class="block w-full align-top object-cover transition-transform duration-slow group-hover:scale-[1.025] group-focus-within:scale-[1.025]"
              />
            </button>
            <div class="flex items-start justify-between gap-3 pt-3">
              <div class="min-w-0">
                {photo.location && (
                  <p class="text-xs font-medium leading-5 tracking-[0.08em] text-muted uppercase">
                    {photo.location}
                  </p>
                )}
                <a
                  href={withBase(`photo/${photo.id}/`)}
                  class="mt-1 block truncate font-display text-xl text-text transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >
                  {photo.title}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-9 rounded-xl border border-dashed border-lineStrong bg-surface px-6 py-12 text-center">
        <p class="font-display text-2xl text-text">No photographs yet</p>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-muted">
          The first collection is still being prepared.
        </p>
      </div>
    )
  }

  <p id="empty-filter-state" class="mt-6 hidden rounded-xl border border-dashed border-lineStrong bg-surface px-6 py-8 text-center text-muted">
    No photographs match this theme.
  </p>
</section>

<PhotoLightbox />

<script is:inline define:vars={{ photoDataUrl: withBase("photo-data.json"), initialVisibleCount }}>
  // @ts-nocheck
  const el = (id) => document.getElementById(id);

  const photoRecords = new Map();
  let photosPromise = null;
  const grid = el("photo-grid");
  const cards = Array.from(document.querySelectorAll("[data-photo-card]"));
  const emptyFilterState = el("empty-filter-state");
  const tagPills = Array.from(document.querySelectorAll(".tag-pill"));
  const archiveToggle = el("archive-toggle");
  const galleryCount = el("gallery-count");

  const dialog = el("photo-lightbox");
  const dialogImage = el("lightbox-image");
  const dialogTitle = el("lightbox-title");
  const dialogDescription = el("lightbox-description");
  const dialogDate = el("lightbox-date");
  const dialogLocation = el("lightbox-location");
  const dialogCamera = el("lightbox-camera");
  const dialogLens = el("lightbox-lens");
  const dialogAperture = el("lightbox-aperture");
  const dialogShutter = el("lightbox-shutter");
  const dialogIso = el("lightbox-iso");
  const dialogFocalLength = el("lightbox-focal-length");
  const dialogPosition = el("lightbox-position");
  const dialogStatus = el("lightbox-status");
  const prevButton = el("lightbox-prev");
  const nextButton = el("lightbox-next");
  const closeButton = el("lightbox-close");
  const mediaContainer = el("lightbox-media-container");

  const lightboxEnabled = Boolean(dialog && dialogImage);

  let filteredPhotoIds = [];
  let activeIndex = -1;
  let activeTag = "";
  let archiveExpanded = false;
  let visibleLimit = initialVisibleCount;
  let touchStartX = null;
  let touchEndX = null;
  let currentColumnCount = 0;

  const activePillClasses = "border-accent bg-accent/10 text-accent";
  const inactivePillClasses = "border-lineStrong text-muted";

  const setActiveTag = (tag) => {
    activeTag = tag;
    tagPills.forEach((pill) => {
      const isActive = pill.getAttribute("data-tag") === tag;
      pill.setAttribute("aria-pressed", String(isActive));
      pill.className = pill.className
        .replace(/border-accent|bg-accent\/10|text-accent|border-lineStrong|text-muted/g, "")
        .trim();
      pill.classList.add(...(isActive ? activePillClasses : inactivePillClasses).split(" "));
    });
  };

  const updateURL = () => {
    const params = new URLSearchParams();
    if (activeTag) params.set("tag", activeTag);
    const next = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ""}`;
    window.history.replaceState({}, "", next);
  };

  const getColumnCount = () => {
    if (window.matchMedia("(min-width: 1280px)").matches) return 4;
    if (window.matchMedia("(min-width: 1024px)").matches) return 3;
    if (window.matchMedia("(min-width: 640px)").matches) return 2;
    return 1;
  };

  const buildColumns = (visibleCards, hiddenCards) => {
    if (!grid) return;

    const columnCount = getColumnCount();
    currentColumnCount = columnCount;
    grid.style.setProperty("--masonry-column-count", String(columnCount));
    grid.textContent = "";

    const columns = Array.from({ length: columnCount }, () => {
      const column = document.createElement("div");
      column.className = "masonry-column";
      grid.appendChild(column);
      return column;
    });
    const columnHeights = Array(columnCount).fill(0);

    visibleCards.forEach((card) => {
      const targetIndex = columnHeights.indexOf(Math.min(...columnHeights));
      const aspect = Number(card.getAttribute("data-photo-aspect")) || 1;
      columns[targetIndex].appendChild(card);
      columnHeights[targetIndex] += 1 / aspect;
    });

    hiddenCards.forEach((card) => grid.appendChild(card));
  };

  const updateArchiveControls = (visibleCount) => {
    if (archiveToggle) {
      archiveToggle.setAttribute("aria-expanded", String(archiveExpanded));
      archiveToggle.textContent = archiveExpanded
        ? archiveToggle.dataset.expandedLabel
        : archiveToggle.dataset.collapsedLabel;
    }
    if (galleryCount) galleryCount.textContent = `Showing ${visibleCount} of ${cards.length}`;
  };

  const applyFilter = () => {
    filteredPhotoIds = [];
    let totalMatchCount = 0;
    let visibleMatchCount = 0;
    const visibleCards = [];
    const hiddenCards = [];

    cards.forEach((card) => {
      const tags = (card.getAttribute("data-tags") ?? "").split("|").filter(Boolean);
      const isMatch = !activeTag || tags.includes(activeTag);

      if (!isMatch) {
        card.classList.add("hidden");
        hiddenCards.push(card);
        return;
      }

      totalMatchCount += 1;
      const isVisible = visibleMatchCount < visibleLimit;
      card.classList.toggle("hidden", !isVisible);
      if (isVisible) {
        const id = card.getAttribute("data-photo-id");
        if (id) filteredPhotoIds.push(id);
        visibleCards.push(card);
      } else {
        hiddenCards.push(card);
      }
      visibleMatchCount += 1;
    });

    buildColumns(visibleCards, hiddenCards);
    emptyFilterState?.classList.toggle("hidden", totalMatchCount !== 0 || cards.length === 0);
    updateArchiveControls(visibleCards.length);
    updateURL();
  };

  const setArchiveExpanded = (expanded) => {
    archiveExpanded = expanded;
    visibleLimit = expanded ? cards.length : initialVisibleCount;
    applyFilter();
  };

  const readFromURL = () => {
    const params = new URLSearchParams(window.location.search);
    const tag = params.get("tag") ?? "";
    setActiveTag(tag);
    if (tag) {
      archiveExpanded = true;
      visibleLimit = cards.length;
    }
  };

  const hasValue = (value) => Boolean(value && String(value).trim() && String(value).trim() !== "-");

  const fill = (element, value, hideEmpty = false) => {
    if (!element) return;
    const isVisible = hasValue(value);
    element.textContent = isVisible ? value : "";
    if (hideEmpty) element.closest("[data-lightbox-meta]")?.classList.toggle("hidden", !isVisible);
  };

  const ensurePhotosLoaded = async () => {
    if (photoRecords.size > 0) return true;
    if (!photosPromise) {
      photosPromise = fetch(photoDataUrl, { credentials: "same-origin" })
        .then((response) => {
          if (!response.ok) throw new Error(`Failed to load photo data: ${response.status}`);
          return response.json();
        })
        .then((payload) => {
          if (!Array.isArray(payload)) return false;
          payload.forEach((photo) => {
            if (photo?.id) photoRecords.set(String(photo.id), photo);
          });
          return photoRecords.size > 0;
        })
        .catch((error) => {
          console.error(error);
          return false;
        });
    }
    return photosPromise;
  };

  const renderActivePhoto = () => {
    if (activeIndex < 0 || activeIndex >= filteredPhotoIds.length) return false;
    const currentPhoto = photoRecords.get(filteredPhotoIds[activeIndex]);
    if (!currentPhoto) return false;

    dialogImage.setAttribute("src", currentPhoto.fullSrc);
    dialogImage.setAttribute("alt", currentPhoto.title);
    fill(dialogTitle, currentPhoto.title);
    fill(dialogDescription, currentPhoto.description);
    dialogDescription?.classList.toggle("hidden", !hasValue(currentPhoto.description));
    fill(dialogDate, new Date(currentPhoto.publishedAt).toLocaleDateString());
    fill(dialogLocation, currentPhoto.location, true);
    fill(dialogCamera, currentPhoto.camera, true);
    fill(dialogLens, currentPhoto.lens, true);
    fill(dialogAperture, currentPhoto.aperture, true);
    fill(dialogShutter, currentPhoto.shutter, true);
    fill(dialogIso, currentPhoto.iso, true);
    fill(dialogFocalLength, currentPhoto.focalLength, true);
    fill(dialogPosition, `${activeIndex + 1} / ${filteredPhotoIds.length}`);
    dialogStatus?.classList.add("hidden");
    dialogImage.classList.remove("hidden");
    return true;
  };

  const openLightbox = async (photoId) => {
    if (!lightboxEnabled || filteredPhotoIds.length === 0) return;
    activeIndex = filteredPhotoIds.indexOf(photoId);
    if (activeIndex < 0) activeIndex = 0;

    dialogImage.classList.add("hidden");
    if (dialogStatus) {
      dialogStatus.textContent = "Loading photograph";
      dialogStatus.classList.remove("hidden");
    }
    dialog.showModal();
    document.body.style.overflow = "hidden";

    const loaded = await ensurePhotosLoaded();
    if (!loaded || !renderActivePhoto()) {
      if (dialogStatus) dialogStatus.textContent = "The photograph could not be loaded.";
    }
  };

  const closeLightbox = () => {
    dialog.close();
    document.body.style.overflow = "";
    activeIndex = -1;
  };

  const stepLightbox = (delta) => {
    if (filteredPhotoIds.length <= 1) return;
    activeIndex = (activeIndex + delta + filteredPhotoIds.length) % filteredPhotoIds.length;
    renderActivePhoto();
  };

  document.querySelectorAll("[data-open-lightbox]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.getAttribute("data-open-lightbox");
      if (id) void openLightbox(id);
    });
  });

  archiveToggle?.addEventListener("click", () => setArchiveExpanded(!archiveExpanded));

  tagPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      setActiveTag(pill.getAttribute("data-tag") ?? "");
      if (activeTag) {
        archiveExpanded = true;
        visibleLimit = cards.length;
      }
      applyFilter();
    });
  });

  [640, 1024, 1280].forEach((breakpoint) => {
    window.matchMedia(`(min-width: ${breakpoint}px)`).addEventListener("change", () => {
      const nextColumnCount = getColumnCount();
      if (nextColumnCount !== currentColumnCount) applyFilter();
    });
  });

  if (lightboxEnabled) {
    prevButton?.addEventListener("click", () => stepLightbox(-1));
    nextButton?.addEventListener("click", () => stepLightbox(1));
    closeButton?.addEventListener("click", closeLightbox);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeLightbox();
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "ArrowLeft") stepLightbox(-1);
      if (event.key === "ArrowRight") stepLightbox(1);
    });

    mediaContainer?.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0]?.screenX ?? null;
    });
    mediaContainer?.addEventListener("touchend", (event) => {
      touchEndX = event.changedTouches[0]?.screenX ?? null;
      if (touchStartX == null || touchEndX == null) return;
      const delta = touchStartX - touchEndX;
      if (Math.abs(delta) < 50) return;
      if (delta > 0) stepLightbox(1);
      if (delta < 0) stepLightbox(-1);
    });
  }

  readFromURL();
  applyFilter();
</script>
