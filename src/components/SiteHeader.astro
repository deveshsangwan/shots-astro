---
import { navigation, siteConfig } from "@/config/site";
import { withBase } from "@/utils/withBase";

const pathname = Astro.url.pathname;
const homeHref = withBase();
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur-md">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-[minmax(0,1fr)_auto] items-center gap-3 px-4 py-3 sm:px-5 md:px-8 md:py-4">
    <a href={homeHref} class="group min-w-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg">
      <p class="truncate font-display text-lg tracking-wide text-text sm:text-xl md:text-2xl">
        <span class="sm:hidden">{siteConfig.shortTitle}</span>
        <span class="hidden sm:inline">{siteConfig.title}</span>
      </p>
      <p class="hidden truncate text-xs tracking-[0.16em] text-muted uppercase transition-colors group-hover:text-accent md:block">
        {siteConfig.subtitle}
      </p>
    </a>
    <nav aria-label="Main navigation" class="flex shrink-0 items-center gap-0.5 rounded-full border border-line bg-surface/80 p-1 sm:gap-1">
      {navigation.map((item) => {
        const href = item.href === "/" ? homeHref : withBase(item.href);
        const normalizedHref = href.replace(/\/$/, "");
        const normalizedPathname = pathname.replace(/\/$/, "");
        const isActive = normalizedPathname === normalizedHref;

        return (
          <a
            href={href}
            class:list={[
              "whitespace-nowrap rounded-full px-3 py-2 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:px-4 sm:text-sm",
              isActive
                ? "bg-accent text-accentInk"
                : "text-muted hover:bg-surfaceSoft hover:text-text focus-visible:bg-surfaceSoft focus-visible:text-text"
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
