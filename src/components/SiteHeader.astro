---
import { navigation, siteConfig } from "@/config/site";
import { withBase } from "@/utils/withBase";

const pathname = Astro.url.pathname;
const homeHref = withBase();
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur-xl">
  <div class="mx-auto flex h-16 w-full max-w-[1600px] items-center justify-between gap-6 px-5 md:h-[72px] md:px-8 lg:px-12">
    <a
      href={homeHref}
      class="group shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg"
      aria-label={`${siteConfig.author}, photography home`}
    >
      <span class="font-display text-base tracking-[-0.03em] text-text sm:text-lg">Devesh Sangwan</span>
      <span class="ml-2 hidden text-xs text-muted sm:inline">Photographs</span>
    </a>

    <nav aria-label="Main navigation" class="flex shrink-0 items-center gap-5 sm:gap-7">
      {navigation.map((item) => {
        const href = item.href === "/" ? homeHref : withBase(item.href);
        const normalizedHref = href.replace(/\/$/, "");
        const normalizedPathname = pathname.replace(/\/$/, "");
        const isActive = normalizedPathname === normalizedHref;

        return (
          <a
            href={href}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "relative whitespace-nowrap py-2 text-sm transition-colors duration-medium after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:bg-accent after:transition-transform after:duration-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
              isActive
                ? "text-text after:scale-x-100"
                : "text-muted after:scale-x-0 hover:text-text hover:after:scale-x-100"
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href={siteConfig.social.instagram}
        target="_blank"
        rel="noreferrer"
        class="hidden py-2 text-sm text-muted transition-colors duration-medium hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:block"
      >
        Instagram
      </a>
    </nav>
  </div>
</header>
