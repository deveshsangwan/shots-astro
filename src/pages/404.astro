---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/withBase";
---

<BaseLayout title="Page not found" noIndex>
  <main class="grid min-h-[100dvh] place-items-center px-6">
    <div class="max-w-lg border-t border-line py-10 text-center">
      <p class="text-sm text-muted">404</p>
      <h1 class="mt-4 font-display text-4xl text-text">Frame not found</h1>
      <p class="mt-4 text-sm leading-7 text-muted">
        The page you are looking for does not exist. Head back to the gallery and keep exploring.
      </p>
      <a
        href={withBase()}
        class="mt-7 inline-flex border-b border-accent pb-1 text-sm text-text transition-colors duration-medium hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent active:translate-y-px"
      >
        Back to gallery
      </a>
    </div>
  </main>
</BaseLayout>
