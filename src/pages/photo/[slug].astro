---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { siteConfig } from "@/config/site";
import { normalizeCameraName } from "@/config/portfolio";
import { getPhotoDisplayTitle, hasDisplayValue } from "@/utils/photoDisplay";
import { withBase } from "@/utils/withBase";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  const sorted = photos.sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );
  return sorted.map((photo, index) => ({
    params: { slug: photo.id },
    props: {
      photo,
      displayTitle: getPhotoDisplayTitle(photo.data.title, index),
      prevPhoto: index > 0 ? sorted[index - 1] : null,
      prevTitle: index > 0 ? getPhotoDisplayTitle(sorted[index - 1].data.title, index - 1) : null,
      nextPhoto: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextTitle: index < sorted.length - 1 ? getPhotoDisplayTitle(sorted[index + 1].data.title, index + 1) : null
    }
  }));
}

const { photo, displayTitle, prevPhoto, prevTitle, nextPhoto, nextTitle } = Astro.props;
const publishedDate = new Date(photo.data.publishedAt);
const pageTitle = `${displayTitle} | ${siteConfig.title}`;
const description = photo.data.description || siteConfig.description;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  name: displayTitle,
  description,
  contentUrl: new URL(photo.data.image.src, siteConfig.url).toString(),
  datePublished: publishedDate.toISOString(),
  author: {
    "@type": "Person",
    name: siteConfig.author
  }
};

const exifFields = [
  { label: "Date", value: publishedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) },
  { label: "Location", value: photo.data.location },
  { label: "Camera", value: normalizeCameraName(photo.data.camera) },
  { label: "Lens", value: photo.data.lens },
  { label: "Aperture", value: photo.data.settings?.aperture },
  { label: "Shutter", value: photo.data.settings?.shutter },
  { label: "ISO", value: photo.data.settings?.iso ? String(photo.data.settings.iso) : null },
  { label: "Focal Length", value: photo.data.settings?.focalLength },
].filter(({ value }) => hasDisplayValue(value));
---

<BaseLayout title={pageTitle} description={description} ogImage={withBase(`social/${photo.id}.svg`)}>
  <SiteHeader />

  <main class="mx-auto w-full max-w-7xl px-5 py-8 md:px-8 md:py-12">
    <!-- Hero image with floating back button -->
    <div class="relative" data-animate>
      <a
        href={withBase()}
        class="absolute left-4 top-4 z-10 rounded-full border border-white/35 bg-black/65 px-4 py-2 text-sm font-medium text-white backdrop-blur-md transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Back to gallery"
      >
        Back to gallery
      </a>
      <div class="overflow-hidden rounded-xl border border-line shadow-elevated">
        <Image
          src={photo.data.image}
          alt={displayTitle}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1280px) 1216px, (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full object-cover"
        />
      </div>
    </div>

    <!-- Metadata section -->
    <div class="mt-8 border-t border-line pt-8" data-animate style="transition-delay: 120ms">
      <div class="grid gap-8 md:grid-cols-[1.4fr_1fr] md:gap-12">
        <!-- Left: title, description, tags -->
        <div class="space-y-5">
          <h1 class="font-display text-4xl leading-tight text-text md:text-5xl">{displayTitle}</h1>
          {photo.data.description && (
            <p class="max-w-xl text-base leading-8 text-muted">{photo.data.description}</p>
          )}
          {photo.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {photo.data.tags.map((tag: string) => (
                <a
                  href={`${withBase()}?tag=${encodeURIComponent(tag)}`}
                  class="rounded-full border border-lineStrong px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Right: EXIF data -->
        <div class="rounded-xl border border-line bg-surface p-5">
          <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-muted uppercase">Capture Details</p>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            {exifFields.map(({ label, value }) => (
              <div>
                <dt class="text-muted">{label}</dt>
                <dd class="mt-0.5 font-medium text-text">{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>

    <!-- Prev / Next navigation -->
    {(prevPhoto || nextPhoto) && (
      <nav class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" data-animate style="transition-delay: 200ms" aria-label="Adjacent photographs">
        {prevPhoto ? (
          <a
            href={withBase(`photo/${prevPhoto.id}/`)}
            class="group rounded-xl border border-line bg-surface p-4 transition-colors hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <p class="text-xs text-muted">Previous photograph</p>
            <p class="mt-1 truncate font-display text-lg text-text transition-colors group-hover:text-accent">{prevTitle}</p>
          </a>
        ) : <div />}
        {nextPhoto ? (
          <a
            href={withBase(`photo/${nextPhoto.id}/`)}
            class="group rounded-xl border border-line bg-surface p-4 text-right transition-colors hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <p class="text-xs text-muted">Next photograph</p>
            <p class="mt-1 truncate font-display text-lg text-text transition-colors group-hover:text-accent">{nextTitle}</p>
          </a>
        ) : <div />}
      </nav>
    )}
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <SiteFooter />
</BaseLayout>
