---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { selectedPhotoIds } from "@/config/portfolio";
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/withBase";

const entries = await getCollection("photos").catch(() => []);
const sortedEntries = entries.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const entryById = new Map(sortedEntries.map((entry) => [entry.id, entry]));
const contactSheet = selectedPhotoIds
  .slice(0, 3)
  .map((id) => entryById.get(id))
  .filter((entry): entry is (typeof sortedEntries)[number] => Boolean(entry));
---

<BaseLayout title={`About | ${siteConfig.title}`} description={siteConfig.footer.bio}>
  <SiteHeader />

  <main class="mx-auto w-full max-w-[1600px] px-5 py-14 md:px-8 md:py-24 lg:px-12">
    <section class="grid gap-14 lg:grid-cols-12 lg:items-end lg:gap-8" data-animate>
      <div class="lg:col-span-5">
        <h1 class="max-w-3xl font-display text-5xl leading-[0.98] text-text md:text-7xl lg:text-8xl">
          Places worth returning to.
        </h1>
        <div class="mt-8 max-w-xl space-y-5 text-base leading-8 text-muted md:text-lg md:leading-9">
          <p>
            I am Devesh, a photographer based in New Delhi. I photograph landscapes, city edges, forests, and mountain roads.
          </p>
          <p>
            Most of this archive was made while travelling through Rajasthan, Uttarakhand, Himachal Pradesh, and Delhi.
          </p>
        </div>
      </div>

      {contactSheet.length > 0 && (
        <div class="grid grid-cols-[1.12fr_0.88fr] gap-2 lg:col-span-7 lg:col-start-6" aria-label="Selected photographs">
          {contactSheet.map((entry, index) => (
            <a
              href={withBase(`photo/${entry.id}/`)}
              class:list={[
                "group block overflow-hidden bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
                index === 0 && "row-span-2"
              ]}
              aria-label={`View ${entry.data.title || "selected photograph"}`}
            >
              <Image
                src={entry.data.thumbnail ?? entry.data.image}
                alt={entry.data.title || "Photograph by Devesh Sangwan"}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 28vw, 44vw"
                format="webp"
                quality={72}
                class:list={[
                  "h-full min-h-0 w-full object-cover transition-transform duration-slow group-hover:scale-[1.025]",
                  index === 0 ? "aspect-[4/5]" : "aspect-[4/3]"
                ]}
              />
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="mt-24 border-t border-line pt-10 md:mt-32" data-animate>
      <h2 class="font-display text-4xl leading-tight text-text md:text-6xl">How I photograph</h2>
      <div class="mt-6 max-w-2xl space-y-4 text-base leading-8 text-muted md:text-lg md:leading-9">
        <p>I look for changes in weather, distance, and light that make a familiar place feel new.</p>
        <p>The camera stays secondary. The photograph begins with slowing down long enough to notice.</p>
      </div>
    </section>

    <section class="mt-24 border-t border-line pt-10 md:mt-32" data-animate>
      <p class="max-w-2xl font-display text-4xl leading-tight text-text md:text-6xl">The photographs are the best introduction.</p>
      <a
        href={withBase()}
        class="mt-8 inline-flex border-b border-accent pb-1 text-sm font-semibold text-text transition-colors duration-medium hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent active:translate-y-px"
      >
        View gallery
      </a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
