---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { normalizeCameraName, selectedPhotoIds } from "@/config/portfolio";
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/withBase";

const entries = await getCollection("photos").catch(() => []);
const sortedEntries = entries.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const totalPhotos = sortedEntries.length;

const cameraMap = new Map<string, number>();
sortedEntries.forEach((entry) => {
  const camera = normalizeCameraName(entry.data.camera);
  if (camera) cameraMap.set(camera, (cameraMap.get(camera) ?? 0) + 1);
});
const cameras = Array.from(cameraMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

const years = sortedEntries.map((entry) => entry.data.publishedAt.getFullYear());
const yearRange = years.length > 0
  ? Math.min(...years) === Math.max(...years)
    ? String(Math.max(...years))
    : `${Math.min(...years)}-${Math.max(...years)}`
  : "Not recorded";

const topCamera = cameras[0]?.[0] ?? "Not recorded";
const entryById = new Map(sortedEntries.map((entry) => [entry.slug, entry]));
const contactSheet = selectedPhotoIds
  .slice(0, 3)
  .map((id) => entryById.get(id))
  .filter((entry): entry is (typeof sortedEntries)[number] => Boolean(entry));
---

<BaseLayout title={`About | ${siteConfig.title}`} description={siteConfig.footer.bio}>
  <SiteHeader />

  <main class="mx-auto w-full max-w-6xl px-5 py-12 md:px-8 md:py-20">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(24rem,1.1fr)] lg:items-center lg:gap-16" data-animate>
      <div>
        <p class="text-xs tracking-[0.22em] text-muted uppercase">About</p>
        <h1 class="mt-3 max-w-2xl font-display text-5xl leading-[1.05] text-text md:text-7xl">
          Places, light, and the moments between.
        </h1>
        <div class="mt-7 max-w-2xl space-y-5 text-base leading-8 text-muted md:text-lg md:leading-9">
          <p>
            I am Devesh, a photographer from New Delhi. I am drawn to open landscapes, city edges, and the way light can change a familiar place.
          </p>
          <p>
            This portfolio brings those frames together with the dates and locations that shaped them.
          </p>
        </div>
      </div>

      {contactSheet.length > 0 && (
        <div class="grid grid-cols-[1.12fr_0.88fr] gap-3" aria-label="Selected photographs">
          {contactSheet.map((entry, index) => (
            <a
              href={withBase(`photo/${entry.slug}/`)}
              class:list={[
                "group block overflow-hidden rounded-xl border border-line bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
                index === 0 && "row-span-2"
              ]}
              aria-label={`View ${entry.data.title || "selected photograph"}`}
            >
              <Image
                src={entry.data.thumbnail ?? entry.data.image}
                alt={entry.data.title || "Photograph by Devesh Sangwan"}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 28vw, 44vw"
                format="webp"
                quality={72}
                class:list={[
                  "h-full min-h-0 w-full object-cover transition-transform duration-slow group-hover:scale-[1.025]",
                  index === 0 ? "aspect-[4/5]" : "aspect-[4/3]"
                ]}
              />
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-line pt-10 md:mt-24 md:grid-cols-3 md:gap-x-12" data-animate>
      <div>
        <p class="text-sm text-muted">Photographs</p>
        <p class="mt-2 font-display text-4xl text-text">{totalPhotos}</p>
      </div>
      <div>
        <p class="text-sm text-muted">Years</p>
        <p class="mt-2 font-display text-4xl text-text">{yearRange}</p>
      </div>
      <div class="col-span-2 md:col-span-1">
        <p class="text-sm text-muted">Most-used camera</p>
        <p class="mt-2 font-display text-3xl text-text">{topCamera}</p>
      </div>
    </section>

    {cameras.length > 0 && (
      <section class="mt-16 border-t border-line pt-10 md:mt-20" data-animate>
        <h2 class="font-display text-3xl text-text md:text-4xl">Cameras in the archive</h2>
        <p class="mt-3 max-w-xl text-sm leading-7 text-muted md:text-base">
          The equipment changed over time. The attention to place stayed consistent.
        </p>
        <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {cameras.map(([name, count]) => (
            <div class="flex items-baseline justify-between gap-4 border-t border-line pt-4">
              <p class="font-medium text-text">{name}</p>
              <p class="whitespace-nowrap text-sm text-muted">{count} {count === 1 ? "photograph" : "photographs"}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-16 border-t border-line pt-10 md:mt-20" data-animate>
      <p class="max-w-xl font-display text-3xl leading-tight text-text">The photographs are the best introduction.</p>
      <a
        href={withBase()}
        class="mt-6 inline-flex rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accentInk transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg active:scale-[0.98]"
      >
        Gallery
      </a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
